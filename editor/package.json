    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "audit-ci": "^7.1.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  }
