<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      WebKit requires the network client entitlement to initialize its
      helper processes, even for the bundled file-only editor. Jot does
      not load remote pages or require an internet connection.
      `NotesLibrary`'s use of `applicationSupportDirectory` resolves to
      this app's own sandbox container. The user-selected read/write
      entitlement is only for "Export…", which writes where the user picks
      in a save panel.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
