<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      WebKit requires the network client entitlement to initialize its
      helper processes, even for the bundled file-only editor. Jot does
      not load remote pages or require an internet connection.
      `NoteStore`'s use of
      `FileManager`'s `applicationSupportDirectory` resolves transparently
      to this app's own sandbox container, so no
      `com.apple.security.files.*` entitlement is needed either.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
